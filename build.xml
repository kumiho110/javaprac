<?xml version="1.0" encoding="UTF-8"?>
<project name="javaprac-db" default="help" basedir=".">

    <property file="build.properties"/>

    <property name="psql.bin" value="psql"/>
    <property name="pgdump.bin" value="pg_dump"/>
    <property name="gradlew.bin" value="./gradlew"/>

    <property name="db.dir" value="db"/>
    <property name="sql.create" value="${db.dir}/create.sql"/>
    <property name="sql.init" value="${db.dir}/init.sql"/>
    <property name="sql.cleanup" value="${db.dir}/cleanup.sql"/>

    <property name="db.url" value="jdbc:postgresql://${db.host}:${db.port}/${db.name}"/>

    <property name="app.port" value="8080"/>
    <property name="app.baseUrl" value="http://localhost:${app.port}"/>
    <property name="app.healthPath" value="/login"/>
    <property name="app.jar" value="build/libs/javaprac-0.0.1-SNAPSHOT.jar"/>
    <property name="app.log" value="build/app-local.log"/>
    <property name="app.pidfile" value="build/app-local.pid"/>

    <target name="help">
        <echo>Targets:</echo>
        <echo>  db-create        - run create.sql</echo>
        <echo>  db-init          - run init.sql</echo>
        <echo>  db-clean         - run cleanup.sql</echo>
        <echo>  db-reset         - clean + create + init</echo>
        <echo>  db-show          - show basic contents (counts)</echo>
        <echo>  db-dump          - dump database to ${dump.file}</echo>
        <echo>  compile          - build main project classes via Gradle</echo>
        <echo>  compile-tests    - build test classes via Gradle</echo>
        <echo>  test-db-reset    - clean DB + create schema for DAO tests</echo>
        <echo>  test             - reset empty DB and run DAO/unit tests via Gradle</echo>
        <echo>  test-report      - reset empty DB, run DAO/unit tests, build JaCoCo report</echo>
        <echo>  deploy-local     - reset seeded DB, build jar, start app locally</echo>
        <echo>  undeploy-local   - stop locally started app</echo>
        <echo>  system-test      - run Selenium system tests against local app</echo>
        <echo>  system-test-stop - run system tests and then stop local app</echo>
    </target>

    <macrodef name="run-psql-file">
        <attribute name="file"/>
        <sequential>
            <exec executable="${psql.bin}" failonerror="true">
                <env key="PGPASSWORD" value="${db.password}"/>
                <arg value="-h"/><arg value="${db.host}"/>
                <arg value="-p"/><arg value="${db.port}"/>
                <arg value="-U"/><arg value="${db.user}"/>
                <arg value="-d"/><arg value="${db.name}"/>
                <arg value="-f"/><arg value="@{file}"/>
            </exec>
        </sequential>
    </macrodef>

    <macrodef name="run-psql-command">
        <attribute name="sql"/>
        <sequential>
            <exec executable="${psql.bin}" failonerror="true">
                <env key="PGPASSWORD" value="${db.password}"/>
                <arg value="-h"/><arg value="${db.host}"/>
                <arg value="-p"/><arg value="${db.port}"/>
                <arg value="-U"/><arg value="${db.user}"/>
                <arg value="-d"/><arg value="${db.name}"/>
                <arg value="-c"/><arg value="@{sql}"/>
            </exec>
        </sequential>
    </macrodef>

    <macrodef name="run-gradle">
        <attribute name="tasks"/>
        <sequential>
            <exec executable="${gradlew.bin}" failonerror="true">
                <arg value="-Ddb.url=${db.url}"/>
                <arg value="-Ddb.user=${db.user}"/>
                <arg value="-Ddb.password=${db.password}"/>
                <arg line="@{tasks}"/>
            </exec>
        </sequential>
    </macrodef>

    <target name="db-create">
        <available file="${sql.create}" property="create.exists"/>
        <fail unless="create.exists">Missing file: ${sql.create}</fail>
        <run-psql-file file="${sql.create}"/>
    </target>

    <target name="db-init">
        <available file="${sql.init}" property="init.exists"/>
        <fail unless="init.exists">Missing file: ${sql.init}</fail>
        <run-psql-file file="${sql.init}"/>
    </target>

    <target name="db-clean">
        <available file="${sql.cleanup}" property="cleanup.exists"/>
        <fail unless="cleanup.exists">Missing file: ${sql.cleanup}</fail>
        <run-psql-file file="${sql.cleanup}"/>
    </target>

    <target name="db-reset" depends="db-clean,db-create,db-init"/>

    <target name="db-dump">
        <exec executable="${pgdump.bin}" failonerror="true" output="${dump.file}">
            <env key="PGPASSWORD" value="${db.password}"/>
            <arg value="-h"/><arg value="${db.host}"/>
            <arg value="-p"/><arg value="${db.port}"/>
            <arg value="-U"/><arg value="${db.user}"/>
            <arg value="-d"/><arg value="${db.name}"/>
            <arg value="--no-owner"/>
            <arg value="--no-privileges"/>
        </exec>
        <echo>Dump written to ${dump.file}</echo>
    </target>

    <target name="db-show">
        <run-psql-command sql="select 'app_user' as t, count(*) as c from app_user union all
                           select 'product_type', count(*) from product_type union all
                           select 'manufacturer', count(*) from manufacturer union all
                           select 'product', count(*) from product union all
                           select 'product_type_attribute', count(*) from product_type_attribute union all
                           select 'product_attribute_value', count(*) from product_attribute_value union all
                           select 'orders', count(*) from orders union all
                           select 'order_item', count(*) from order_item
                           order by t;"/>
    </target>

    <target name="compile">
        <run-gradle tasks="classes"/>
    </target>

    <target name="compile-tests" depends="compile">
        <run-gradle tasks="testClasses"/>
    </target>

    <target name="test-db-reset" depends="db-clean,db-create"/>

    <target name="test" depends="test-db-reset,compile-tests">
        <run-gradle tasks="cleanTest test"/>
    </target>

    <target name="test-report" depends="test-db-reset,compile-tests">
        <run-gradle tasks="cleanTest test jacocoTestReport"/>
        <echo>JaCoCo HTML report: build/reports/jacoco/test/html/index.html</echo>
    </target>

    <target name="prepare-app-build">
        <mkdir dir="build"/>
    </target>

    <target name="kill-old-local-if-any" depends="prepare-app-build">
        <exec executable="/bin/sh" failonerror="false">
            <arg value="-c"/>
            <arg value="if [ -f '${app.pidfile}' ]; then PID=$(cat '${app.pidfile}'); if kill -0 $PID 2&gt;/dev/null; then kill $PID 2&gt;/dev/null || true; sleep 2; kill -9 $PID 2&gt;/dev/null || true; fi; rm -f '${app.pidfile}'; fi"/>
        </exec>
    </target>

    <target name="build-app-jar">
        <run-gradle tasks="clean bootJar"/>
    </target>

    <target name="deploy-local" depends="kill-old-local-if-any,db-reset,build-app-jar">
        <available file="${app.jar}" property="app.jar.exists"/>
        <fail unless="app.jar.exists">Missing jar: ${app.jar}</fail>

        <exec executable="/bin/sh" failonerror="true">
            <arg value="-c"/>
            <arg value="nohup java -Dserver.port=${app.port} -Ddb.url=${db.url} -Ddb.user=${db.user} -Ddb.password=${db.password} -jar '${app.jar}' &gt; '${app.log}' 2&gt;&amp;1 &amp; echo $! &gt; '${app.pidfile}'"/>
        </exec>

        <waitfor maxwait="60" maxwaitunit="second" checkevery="2" checkeveryunit="second" timeoutproperty="app.start.timeout">
            <http url="${app.baseUrl}${app.healthPath}"/>
        </waitfor>

        <fail if="app.start.timeout">Application did not become ready at ${app.baseUrl}${app.healthPath}. Check ${app.log}</fail>

        <echo>Application started at ${app.baseUrl}</echo>
    </target>

    <target name="undeploy-local" depends="prepare-app-build">
        <exec executable="/bin/sh" failonerror="false">
            <arg value="-c"/>
            <arg value="if [ -f '${app.pidfile}' ]; then PID=$(cat '${app.pidfile}'); if kill -0 $PID 2&gt;/dev/null; then kill $PID 2&gt;/dev/null || true; for i in 1 2 3 4 5; do if kill -0 $PID 2&gt;/dev/null; then sleep 1; else break; fi; done; if kill -0 $PID 2&gt;/dev/null; then kill -9 $PID 2&gt;/dev/null || true; fi; fi; rm -f '${app.pidfile}'; else true; fi"/>
        </exec>
    </target>

    <target name="system-test" depends="deploy-local,compile-tests">
        <run-gradle tasks="-DbaseUrl=${app.baseUrl} cleanSystemTest systemTest"/>
    </target>

    <target name="full-build" depends="deploy-local">
        <echo>Application has been fully built and deployed at ${app.baseUrl}</echo>
    </target>

    <target name="system-test-stop" depends="system-test,undeploy-local"/>

</project>